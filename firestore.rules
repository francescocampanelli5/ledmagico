rules_version = '2';

// Regole di sicurezza Firestore per LedMagico.
// Incolla questo contenuto in Firebase Console → Firestore Database → Regole.
//
// Logica generale:
// - Chiunque può leggere i prodotti attivi (negozio pubblico).
// - Solo l'amministratore autenticato può creare/modificare/eliminare prodotti.
// - Chiunque può CREARE un ordine, una richiesta preventivo o un'iscrizione
//   newsletter (form pubblici del sito), ma solo l'amministratore può
//   leggerli, modificarli o eliminarli: i visitatori non possono leggere
//   i dati di altri clienti.
// - La coda email (mail_outbox) è scrivibile dal sito per accodare un invio,
//   ma leggibile/gestibile solo dallo script che invia le email, il quale
//   accede con permessi di proprietario del progetto Google (bypassa queste
//   regole) — quindi nessun visitatore può leggere la coda né segnarla come
//   inviata.

service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if resource.data.active == true || request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerEmail is string
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.subtotalCents is int
                    && request.resource.data.personalizationAck == true;
      allow read, update, delete: if request.auth != null;
    }

    match /quotes/{quoteId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.idea is string;
      allow read, update, delete: if request.auth != null;
    }

    match /subscribers/{subscriberId} {
      // "create" copre sia la prima iscrizione sia una nuova iscrizione dopo
      // essersi disiscritti (setDoc con merge): in entrambi i casi serve solo
      // un'email in formato valido. L'aggiornamento pubblico è limitato a
      // questo stesso schema, così un link di disiscrizione nelle email può
      // sempre funzionare senza dover prima autenticarsi.
      allow create, update: if request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
      allow read, delete: if request.auth != null;
    }

    match /mail_outbox/{mailId} {
      allow create: if request.resource.data.type is string
                    && request.resource.data.sent == false;
      allow read, update, delete: if request.auth != null;
    }

    // Impostazioni del negozio (es. dati per il bonifico): lettura pubblica
    // perché va mostrata al cliente dopo il checkout, scrittura riservata
    // all'amministratore. Tenere questi dati in Firestore (invece che nel
    // codice sorgente) evita che finiscano nella cronologia pubblica di Git.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
